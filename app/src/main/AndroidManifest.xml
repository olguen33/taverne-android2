<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:allowBackup="true" android:label="La Taverne" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:icon="@drawable/app_icon">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="unspecified">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <activity android:name=".SharedActivity" android:exported="false" android:screenOrientation="unspecified" />
    </application>
</manifest>
